<script src="https://cdn.tailwindcss.com"></script>

<div class="flex min-h-screen bg-slate-50">

  <!-- Sidebar -->
  <div class="sidebar w-[280px] flex-shrink-0 bg-gradient-to-b from-blue-950 to-slate-950 flex flex-col">

    <div class="sidebar-header px-6 py-6 border-b border-blue-900/60">
      <div class="flex items-center gap-3">
        <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl bg-amber-400/10 border border-amber-400/30 text-xl">
          🎾
        </div>
        <div>
          <h2 class="text-base font-extrabold text-white tracking-tight leading-tight">ระบบจองสนามเทนนิส</h2>
          <p class="text-[11px] text-blue-400 font-medium tracking-wide mt-0.5">Court Reservation</p>
        </div>
      </div>
    </div>

    <div class="sidebar-content flex-1 flex flex-col px-5 py-6">

      <% if session[:userinfo].present? %>
        <% current_user = User.find_by(id: session[:user_id]) %>

        <div class="user-profile text-center mb-6 pb-6 border-b border-blue-900/60">
          <div class="relative w-16 h-16 mx-auto mb-3">
            <div class="absolute inset-0 rounded-full bg-amber-400/30 blur-lg"></div>
            <div class="avatar relative w-16 h-16 rounded-full bg-amber-400 text-blue-950 flex items-center justify-center text-2xl font-bold ring-4 ring-blue-950 shadow-lg shadow-amber-500/20">
              <%= session[:userinfo]["name"].to_s[0].upcase %>
            </div>
            <span class="absolute bottom-0.5 right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-400 ring-2 ring-blue-950"></span>
          </div>
          <h3 class="text-white font-semibold text-base mb-0.5"><%= session[:userinfo]["name"] %></h3>
          <p class="text-blue-300 text-xs"><%= session[:userinfo]["email"] %></p>

          <% unless session[:is_admin] %>
            <div class="mt-4 rounded-xl bg-blue-900/40 border border-amber-400/20 px-4 py-3">
              <div class="flex items-center justify-center gap-1.5 mb-1">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 text-amber-400"><circle cx="12" cy="12" r="8"/><path d="M12 8v8M9 10.5h6M9 13.5h6"/></svg>
                <p class="text-blue-300 text-xs uppercase tracking-wide font-semibold">เครดิตคงเหลือ</p>
              </div>
              <p class="text-amber-400 text-2xl font-extrabold"><%= current_user&.balance || 0 %> <span class="text-sm text-white font-medium">บาท</span></p>
            </div>
          <% end %>
        </div>

        <div class="flex flex-col gap-2.5">
          <% unless session[:is_admin] %>
            <%= button_to new_topup_path, method: :get,
                  class: "btn w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 hover:-translate-y-0.5 text-blue-950 font-bold py-2.5 shadow-md shadow-amber-500/20 transition-all",
                  data: { turbo: false } do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
              เติมเงิน (Top-up)
            <% end %>
          <% end %>

          <% if session[:is_admin] %>
            <%= button_to admin_topups_path, method: :get,
                  class: "btn btn-warning w-full flex items-center justify-center gap-2 rounded-xl bg-blue-900/60 hover:bg-blue-900 text-white font-medium py-2.5 border border-blue-800 transition-colors",
                  data: { turbo: false } do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
              จัดการการเติมเงิน (Admin)
            <% end %>
          <% end %>

          <%= button_to logout_path, method: :delete,
                class: "btn btn-danger w-full flex items-center justify-center gap-2 rounded-xl bg-transparent hover:bg-red-500/10 text-blue-300 hover:text-red-300 font-medium py-2.5 border border-blue-900 hover:border-red-500/40 transition-colors",
                data: { turbo: false } do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            ออกจากระบบ (Logout)
          <% end %>
        </div>

      <% else %>

        <div class="user-profile text-center mb-6">
          <div class="avatar w-16 h-16 mx-auto mb-3 rounded-full bg-blue-900/60 text-blue-400 flex items-center justify-center border-2 border-dashed border-blue-800">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <p class="text-white font-medium text-sm mb-1">ผู้เยี่ยมชม</p>
          <p class="text-blue-300 text-xs">กรุณาเข้าสู่ระบบเพื่อใช้งานเต็มรูปแบบ</p>
        </div>

        <%= button_to "/auth/keycloak", method: :post,
              class: "btn w-full flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-blue-950 font-bold py-2.5 shadow-md shadow-amber-500/20 transition-all",
              data: { turbo: false } do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Login with Keycloak
        <% end %>

      <% end %>

    </div>
  </div>

  <!-- Main Content -->
  <div class="main-content flex-1 bg-slate-50 overflow-y-auto px-6 md:px-10 py-8">

    <% if notice.present? %>
      <div class="flash-messages mb-5 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-700 text-center shadow-sm">
        <%= notice %>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="flash-messages flash-error mb-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700 text-center shadow-sm">
        <%= alert %>
      </div>
    <% end %>

    <% if session[:is_admin] %>

      <div class="admin-maintenance-wrapper max-w-4xl mx-auto">

        <div class="mb-6">
          <h1 class="text-2xl font-extrabold text-blue-950 tracking-tight">จัดการปิดปรับปรุงสนามเทนนิส</h1>
          <p class="text-sm text-slate-500 mt-1">Maintenance Schedule</p>
        </div>

        <!-- Form Card -->
        <div class="rounded-2xl bg-white border border-slate-100 shadow-lg shadow-blue-950/5 p-6 mb-8">
          <h3 class="text-xs font-bold uppercase tracking-widest text-amber-500 mb-4">ตั้งค่าปิดปรับปรุง</h3>

          <%= form_with url: admin_adjustcords_path, method: :post, local: true do |f| %>
            <div class="flex flex-col sm:flex-row gap-4 mb-5">
              <div class="flex-1">
                <label class="block text-sm font-semibold text-blue-950 mb-1.5">ตั้งแต่วันที่</label>
                <input type="date" name="start_date" id="admin_start_date" required min="<%= Date.today.strftime("%Y-%m-%d") %>"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-blue-950 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
              </div>
              <div class="flex-1">
                <label class="block text-sm font-semibold text-blue-950 mb-1.5">ถึงวันที่</label>
                <input type="date" name="end_date" id="admin_end_date" required min="<%= Date.today.strftime("%Y-%m-%d") %>"
                       class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-blue-950 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400">
              </div>
            </div>

            <%= submit_tag "บันทึกการปิดปรับปรุง",
                  class: "btn btn-danger rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold px-6 py-2.5 transition-colors cursor-pointer",
                  data: { turbo: false } %>
          <% end %>

          <script>
            document.addEventListener("DOMContentLoaded", bindAdminDates);
            document.addEventListener("turbo:load", bindAdminDates);

            function bindAdminDates() {
              const startInput = document.getElementById("admin_start_date");
              const endInput = document.getElementById("admin_end_date");
              
              if (startInput && endInput) {
                startInput.addEventListener("change", function() {
                  if (this.value) {
                    endInput.min = this.value;
                  }
                });
                endInput.addEventListener("change", function() {
                  if (this.value) {
                    startInput.max = this.value;
                  }
                });
              }
            }
          </script>
        </div>

        <!-- Table Card -->
        <div class="rounded-2xl bg-white border border-slate-100 shadow-lg shadow-blue-950/5 overflow-hidden">
          <div class="px-6 pt-5">
            <h3 class="text-xs font-bold uppercase tracking-widest text-amber-500 mb-2">รายการปิดปรับปรุงปัจจุบัน</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm mt-2">
              <thead>
                <tr class="bg-blue-950">
                  <th class="px-6 py-3 font-semibold text-blue-200 uppercase tracking-wide text-xs">เริ่มวันที่</th>
                  <th class="px-6 py-3 font-semibold text-blue-200 uppercase tracking-wide text-xs">ถึงวันที่</th>
                  <th class="px-6 py-3 font-semibold text-blue-200 uppercase tracking-wide text-xs">จัดการ</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% @adjustcords.each do |adj| %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-4 font-medium text-blue-950"><%= Date.parse(adj[:start_date]).strftime("%d/%m/%Y") %></td>
                    <td class="px-6 py-4 font-medium text-blue-950"><%= Date.parse(adj[:end_date]).strftime("%d/%m/%Y") %></td>
                    <td class="px-6 py-4">
                      <%= button_to "ยกเลิก", admin_adjustcord_path(adj[:id]), method: :delete,
                            form: { data: { turbo: false } },
                            onclick: "return confirm('ต้องการยกเลิกการปิดปรับปรุงใช่หรือไม่?');",
                            class: "btn btn-warning rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-semibold px-3.5 py-2 transition-colors" %>
                    </td>
                  </tr>
                <% end %>

                <% if @adjustcords.empty? %>
                  <tr>
                    <td colspan="3" class="px-6 py-10 text-center text-slate-400">ยังไม่มีการตั้งค่าปิดปรับปรุง</td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    <% else %>

      <div class="page-wrapper max-w-5xl mx-auto" data-bookings="<%= (@bookings || []).to_json %>" data-closed-dates="<%= (@adjustcords || []).to_json %>">

        <div class="page-header mb-6">
          <h1 data-testid="court-name" class="text-3xl font-extrabold text-blue-950 tracking-tight">Tennis Court Booking</h1>
        </div>

        <% if session[:userinfo].present? %>
          <p class="text-slate-600 mb-6">Hello!, <span class="font-semibold text-blue-950"><%= current_user&.name %></span></p>
        <% end %>

        <!-- <div class="payment-notice mb-8 rounded-xl border-l-4 border-blue-700 bg-blue-50 px-5 py-4">
          <p class="text-sm text-blue-900">
            <strong>Please transfer payment to the following account:</strong>
            KBank, Account Number: 123-4-56789-0 (Account Name: Tennis Club)
          </p>
        </div> -->

        <div class="courts-list flex flex-col gap-6">
          <% (@cords || []).each do |cord| %>
            <div class="court-card flex flex-col md:flex-row rounded-2xl bg-white border border-slate-100 shadow-lg shadow-blue-950/5 overflow-hidden" data-court-id="<%= cord.id %>" data-court-name="<%= cord.name %>">

              <div class="court-image w-full md:w-[280px] flex-shrink-0 bg-slate-200" aria-label="Tennis court image">
                <span class="court-image-content block w-full h-full">
                  <%= image_tag cord.try(:image_url).presence || "Tennis-Court.jpg", alt: cord.name, class: "w-full h-full object-cover aspect-[4/3] md:aspect-auto md:min-h-full" %>
                </span>
              </div>

              <div class="court-details flex-1 flex flex-col p-6">

                <div class="court-status mb-2">
                  <% if cord.temporarily_closed? %>
                    <span class="status-closed text-sm font-semibold text-red-600">Temporarily Closed</span>
                  <% else %>
                    <span class="status-available text-sm font-semibold text-emerald-600">Available</span>
                  <% end %>
                </div>

                <h2 data-testid="court-name" class="text-2xl font-bold text-blue-950 mb-1"><%= cord.name %></h2>
                <p data-testid="court-location" class="text-slate-500 mb-1"><%= cord.location %></p>
                <p data-testid="court-details" class="text-slate-400 text-sm mb-5">Indoor • Hard surface</p>

                <div class="booking-field-group mb-5">
                  <label for="date-<%= cord.id %>" class="block text-sm font-bold text-blue-950 mb-1.5">Booking Date:</label>
                  <input
                    type="date"
                    id="date-<%= cord.id %>"
                    class="court-date-picker w-full max-w-xs rounded-lg border border-slate-300 px-3 py-2 text-sm text-blue-950 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
                    data-court-id="<%= cord.id %>"
                    value="<%= Date.today.strftime("%Y-%m-%d") %>"
                    min="<%= Date.today.strftime("%Y-%m-%d") %>"
                  />
                </div>

                <div class="booking-field-group mb-5">
                  <label for="phone-<%= cord.id %>" class="block text-sm font-bold text-blue-950 mb-1.5">Phone Number:</label>
                  <input
                    type="tel"
                    id="phone-<%= cord.id %>"
                    class="w-full max-w-xs rounded-lg border border-slate-300 px-3 py-2 text-sm text-blue-950 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400"
                    placeholder="กรอกเบอร์โทรศัพท์"
                    required
                  />
                </div>

                <div class="booking-field-group mb-5">
                  <label class="block text-sm font-bold text-blue-950 mb-2">Booking Time Available: 6.00am-24.00pm</label>
                  <div class="slots-container flex flex-wrap gap-2" id="slots-<%= cord.id %>" data-court-id="<%= cord.id %>">
                  </div>
                </div>

                <div class="price-info-tag text-sm text-slate-700 mb-5">
                  ราคาการจอง: <span data-testid="price-amount" class="font-semibold text-blue-950">500 baht</span> / ชั่วโมง
                </div>

                <div class="card-footer mt-auto flex justify-end">
                  <% if cord.temporarily_closed? %>
                    <%= link_to "Temporarily Closed", "#", class: "booking-btn disabled inline-block rounded-xl bg-slate-200 text-slate-400 font-semibold px-6 py-2.5 cursor-not-allowed", disabled: true, "data-testid": "booking-btn" %>
                  <% elsif session[:userinfo].blank? %>
                    <%= button_to "Login to Book", "/auth/keycloak", method: :post,
                          class: "booking-btn rounded-xl bg-blue-950 hover:bg-blue-900 text-white font-semibold px-6 py-2.5 transition-colors",
                          data: { turbo: false } %>
                  <% else %>
                    <button
                      type="button"
                      class="booking-btn rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-blue-950 font-bold px-6 py-2.5 shadow-md shadow-amber-500/20 transition-all"
                      data-testid="booking-btn"
                      data-court-id="<%= cord.id %>"
                      data-court-name="<%= cord.name %>"
                    >
                      Booking
                    </button>
                  <% end %>
                </div>

              </div>
            </div>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>
</div>