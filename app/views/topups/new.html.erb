<script src="https://cdn.tailwindcss.com"></script>

<div class="min-h-screen bg-slate-50 flex items-center justify-center px-4 py-16">
  <div class="w-full max-w-md">

    <!-- Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-400 to-yellow-500 shadow-lg shadow-amber-500/30 mb-4 text-3xl">
        💰
      </div>
      <h1 class="text-3xl font-extrabold text-blue-950 tracking-tight">Top-up Credit</h1>
      <p class="text-sm text-slate-500 mt-1">Top-up Credit</p>
    </div>

    <!-- Bank Info Card -->
    <div class="rounded-2xl bg-blue-950 px-6 py-5 mb-6 shadow-lg shadow-blue-950/20">
      <h3 class="text-xs font-bold uppercase tracking-widest text-amber-400 mb-3 flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M5 6l7-3 7 3M4 10v9m16-9v9M4 19h16M9 14v3m6-3v3"/></svg>
        Bank Information
      </h3>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between">
          <span class="text-blue-300">Bank</span>
          <span class="text-white font-medium">Krungthai Bank</span>
        </div>
        <div class="flex justify-between">
          <span class="text-blue-300">Account Number</span>
          <span class="text-white font-mono font-semibold tracking-wide">123-4-56789-0</span>
        </div>
        <div class="flex justify-between">
          <span class="text-blue-300">Account Name</span>
          <span class="text-white font-medium text-right">Tennis Booking Co., Ltd.</span>
        </div>
      </div>
    </div>

    <!-- Form Card -->
    <div class="rounded-2xl bg-white border border-slate-100 shadow-xl shadow-blue-950/5 p-6">

      <%= form_with(model: @topup, url: topups_path, local: true) do |f| %>

        <h3 class="text-xs font-bold uppercase tracking-widest text-amber-500 mb-4">Select Amount to Top-up</h3>

        <div class="space-y-3 mb-6">
          <label class="flex items-center justify-between rounded-xl border-2 border-slate-100 px-4 py-3.5 cursor-pointer hover:border-amber-300 transition-colors [&:has(input:checked)]:border-amber-400 [&:has(input:checked)]:bg-amber-50">
            <span class="font-semibold text-blue-950">500 THB</span>
            <%= f.radio_button :amount, 500, required: true, class: "w-5 h-5 accent-amber-500" %>
          </label>

          <label class="flex items-center justify-between rounded-xl border-2 border-slate-100 px-4 py-3.5 cursor-pointer hover:border-amber-300 transition-colors [&:has(input:checked)]:border-amber-400 [&:has(input:checked)]:bg-amber-50">
            <span class="font-semibold text-blue-950">1,500 THB</span>
            <%= f.radio_button :amount, 1500, class: "w-5 h-5 accent-amber-500" %>
          </label>

          <label class="flex items-center justify-between rounded-xl border-2 border-slate-100 px-4 py-3.5 cursor-pointer hover:border-amber-300 transition-colors [&:has(input:checked)]:border-amber-400 [&:has(input:checked)]:bg-amber-50">
            <span class="font-semibold text-blue-950">2,500 THB</span>
            <%= f.radio_button :amount, 2500, class: "w-5 h-5 accent-amber-500" %>
          </label>
        </div>

        <%= f.submit "Confirm Top-up", data: { turbo: false },
              class: "w-full rounded-xl bg-gradient-to-r from-amber-400 to-yellow-500 hover:from-amber-300 hover:to-yellow-400 text-blue-950 font-bold py-3 shadow-lg shadow-amber-500/30 transition-all cursor-pointer" %>
      <% end %>

      <div class="mt-4 pt-4 border-t border-slate-100">
        <%= link_to "← Back", root_path,
              class: "block text-center w-full rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium py-2.5 transition-colors" %>
      </div>

    </div>
  </div>
</div>